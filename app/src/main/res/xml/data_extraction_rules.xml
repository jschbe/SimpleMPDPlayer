<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Credentials are stored in noBackupFilesDir, which Android excludes automatically. -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="datastore/sleep_timer.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/sleep_timer.preferences_pb" />
    </device-transfer>
    <!-- No cross-platform transfer partner is configured. -->
</data-extraction-rules>
